---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  carePrinciples,
  primaryCtas,
  resources,
  site
} from "../data/site";

const posts = (await getCollection("news"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const actionPaths = [
  {
    title: "Need Event Support",
    text: "Bring a sanctuary team, harm-reduction education, and a medical/security coordination plan to your event.",
    href: "/organizers/",
    label: "Plan Event Support"
  },
  {
    title: "Train With Us",
    text: "Prepare for grounded peer support through consent-first communication, de-escalation, Narcan response, and clear boundaries.",
    href: "/training/",
    label: "View Training"
  },
  {
    title: "Join the Volunteer Community",
    text: "Help staff sanctuary spaces, support outreach, move supplies, and build a practical culture of care at Midwest gatherings.",
    href: site.forms.volunteer,
    label: "Apply to Volunteer"
  }
];
---

<BaseLayout title={site.name} description={site.description} image="/assets/compassion.png">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-image" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wide-container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Midwest peer support and harm reduction</p>
        <h1 id="home-title">Compassionate peer support for nonordinary states at Midwest events.</h1>
        <p>
          Safe Journey Sanctum creates grounded, consent-first spaces where trained volunteers offer calm presence, practical care, and clear connection to on-site medical or security teams when needed.
        </p>
        <div class="button-row hero-buttons">
          {primaryCtas.map((cta, index) => (
            <a class={`button ${index === 0 ? "button-amber" : index === 1 ? "button-primary" : "button-dark"}`} href={cta.href}>
              {cta.label}
            </a>
          ))}
        </div>
        <div class="button-row secondary-buttons">
          <a class="button button-ghost" href="/events/">View Events</a>
          <a class="button button-ghost" href="/resources/">Read Resources</a>
        </div>
      </div>

      <div class="hero-facts" aria-label="SJS focus areas">
        <span>Sanctuary spaces</span>
        <span>Volunteer training</span>
        <span>Narcan education</span>
        <span>Event partnerships</span>
      </div>
    </div>
  </section>

  <section class="section action-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Start here</p>
        <h2>Choose the path that matches what you need.</h2>
      </div>
      <div class="card-grid">
        {
          actionPaths.map((path) => (
            <article class="surface service-card">
              <h3>{path.title}</h3>
              <p>{path.text}</p>
              <a href={path.href}>{path.label}</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section model-preview">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">Model of care</p>
        <h2>Calm space, consent, and clear escalation.</h2>
        <p class="lede">
          SJS volunteers are not therapists and do not direct anyone's experience. The work is practical: listen well, reduce overwhelm, protect dignity, and know when professional medical support should take over.
        </p>
        <div class="button-row">
          <a class="button button-primary" href="/model/">Explore the Model</a>
          <a class="button button-ghost" href="/faq/">Read FAQ</a>
        </div>
      </div>
      <div class="principle-stack">
        {
          carePrinciples.map((principle) => (
            <article class="principle">
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight band support-band">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">Donate / support</p>
        <h2>Your gift turns intention into working sanctuary infrastructure.</h2>
      </div>
      <div>
        <p>
          Contributions help fund soft flooring, blankets, lighting, hydration supplies, Narcan education, volunteer training, signage, storage, transportation, and outreach materials.
        </p>
        <div class="button-row">
          <a class="button button-amber" href="/donate/">Support SJS</a>
          <a class="button button-ghost" href={site.forms.wishlist}>In-kind Supplies</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section resource-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Practical resources</p>
        <h2>Education that helps people plan, respond, and integrate.</h2>
      </div>
      <div class="card-grid">
        {
          resources.slice(0, 3).map((resource) => (
            <article class="resource-card">
              <h3>{resource.title}</h3>
              <p>{resource.text}</p>
              <a href={resource.href}>Read more</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section latest-section">
    <div class="container">
      <div class="section-heading inline-heading">
        <div>
          <p class="eyebrow">News and field notes</p>
          <h2>Latest from SJS</h2>
        </div>
        <a href="/news/">View all news</a>
      </div>
      <div class="card-grid">
        {
          posts.map((post) => (
            <article class="surface post-card">
              <img src={post.data.image} alt={post.data.imageAlt} loading="lazy" decoding="async" />
              <div class="post-card-body">
                <p class="post-meta">
                  {post.data.category} / {post.data.date.toLocaleDateString("en-US", {
                    month: "short",
                    day: "numeric",
                    year: "numeric"
                  })}
                </p>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <a href={`/news/${post.id}/`}>Read update</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight social-band">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">Stay connected</p>
        <h2>Bring questions, partnership ideas, or volunteer interest.</h2>
      </div>
      <div class="button-row">
        <a class="button button-primary" href="/contact/">Contact SJS</a>
        <a class="button button-ghost" href={site.forms.volunteer}>Volunteer Form</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    min-height: calc(100vh - 74px);
    overflow: hidden;
    position: relative;
  }

  .hero-image {
    background:
      linear-gradient(90deg, rgb(9 7 12 / 0.92), rgb(18 15 23 / 0.66) 48%, rgb(18 15 23 / 0.22)),
      url("/assets/compassion.png");
    background-position: center 35%;
    background-size: cover;
    inset: 0;
    position: absolute;
  }

  .hero-scrim {
    background:
      linear-gradient(180deg, transparent 78%, var(--paper) 100%),
      repeating-linear-gradient(90deg, rgb(246 236 220 / 0.07) 0 1px, transparent 1px 72px);
    inset: 0;
    position: absolute;
  }

  .hero-inner {
    display: grid;
    gap: 32px;
    min-height: calc(100vh - 74px);
    padding-bottom: 74px;
    padding-top: 86px;
    position: relative;
  }

  .hero-copy {
    align-self: center;
    color: white;
    max-width: 840px;
  }

  .hero-copy h1 {
    color: white;
    margin: 16px 0 22px;
    max-width: 800px;
    text-wrap: balance;
  }

  .hero-copy p:not(.eyebrow) {
    color: rgb(255 255 255 / 0.84);
    font-size: 1.2rem;
    max-width: 700px;
  }

  .home-hero .eyebrow {
    color: var(--amber);
  }

  .hero-buttons {
    margin-top: 30px;
  }

  .secondary-buttons {
    margin-top: 12px;
  }

  .hero-facts {
    align-self: end;
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: 920px;
  }

  .hero-facts span {
    background: rgb(31 25 39 / 0.82);
    border: 1px solid var(--line);
    color: var(--ink);
    font-weight: 850;
    min-height: 74px;
    padding: 18px;
  }

  .hero-facts span:first-child {
    border-radius: 8px 0 0 8px;
  }

  .hero-facts span:last-child {
    border-radius: 0 8px 8px 0;
  }

  .section-heading {
    margin-bottom: 28px;
    max-width: 760px;
  }

  .section-heading h2 {
    margin: 8px 0 0;
  }

  .inline-heading {
    align-items: end;
    display: flex;
    justify-content: space-between;
    max-width: none;
  }

  .service-card h3,
  .resource-card h3 {
    margin: 0 0 12px;
  }

  .service-card p,
  .resource-card p {
    color: var(--muted);
    margin-bottom: 18px;
  }

  .model-preview {
    background: rgb(27 21 34 / 0.78);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .model-preview .lede {
    margin: 18px 0 24px;
  }

  .principle-stack {
    display: grid;
    gap: 12px;
  }

  .principle {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 20px;
  }

  .principle h3 {
    font-size: 1.18rem;
    margin: 0 0 8px;
  }

  .principle p {
    color: var(--muted);
  }

  .support-band .button-ghost {
    background: rgb(246 236 220 / 0.1);
    color: white;
  }

  .post-meta {
    color: var(--moss);
    font-size: 0.84rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .post-card h3 {
    margin: 0;
  }

  .post-card p:not(.post-meta) {
    color: var(--muted);
  }

  .social-band {
    background: var(--linen);
    border-top: 1px solid var(--line);
  }

  @media (max-width: 820px) {
    .hero-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-facts span,
    .hero-facts span:first-child,
    .hero-facts span:last-child {
      border-radius: 8px;
    }

    .inline-heading {
      align-items: flex-start;
      display: grid;
      gap: 12px;
    }
  }

  @media (max-width: 560px) {
    .home-hero {
      min-height: auto;
    }

    .hero-inner {
      min-height: 740px;
      padding-bottom: 44px;
      padding-top: 54px;
    }

    .hero-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
